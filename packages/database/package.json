{
  "name": "@app/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "db:generate": "NODE_OPTIONS='--loader ts-node/esm' mikro-orm migration:create",
    "db:migrate": "NODE_OPTIONS='--loader ts-node/esm' mikro-orm migration:up",
    "db:rollback": "NODE_OPTIONS='--loader ts-node/esm' mikro-orm migration:down",
    "db:status": "NODE_OPTIONS='--loader ts-node/esm' mikro-orm migration:pending",
    "db:seed": "bun run src/seed.ts"
  },
  "dependencies": {
    "@app/config": "workspace:*",
    "@app/contracts": "workspace:*",
    "@mikro-orm/core": "6.4.16",
    "@mikro-orm/migrations": "6.4.16",
    "@mikro-orm/mysql": "6.4.16",
    "mysql2": "^3.11.0"
  },
  "devDependencies": {
    "@mikro-orm/cli": "6.4.16",
    "@types/bun": "1.3.14",
    "ts-node": "10.9.2",
    "typescript": "^5.7.0"
  }
}
